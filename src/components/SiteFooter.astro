---
/**
 * Footer-Partial + Sticky-Bar (Port von php/footer.php).
 * Erwartet: s (SiteData).
 */
import { type SiteData, siteGetStr } from '../lib/data.ts';

interface Props {
    s: SiteData;
}

const { s } = Astro.props;
const b = (s['business'] ?? {}) as Record<string, unknown>;
const footer = (s['footer'] ?? {}) as Record<string, unknown>;
const ui = (s['ui'] ?? {}) as Record<string, unknown>;
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <b>{siteGetStr(b, 'name', '')}</b>
      <br />
      <span>{siteGetStr(b, 'street', '')}</span> · <span>{siteGetStr(b, 'postalCode', '')}</span> <span>{siteGetStr(b, 'city', '')}</span>
    </div>
    <div>
      Tel. <a href={siteGetStr(b, 'phoneHref', 'tel:')}>{siteGetStr(b, 'phone', '')}</a>
      <br />
      <a href={'mailto:' + siteGetStr(b, 'email', '')}>{siteGetStr(b, 'email', '')}</a>
    </div>
    <div>
      {siteGetStr(ui, 'footerInhaberLabel', 'Inhaber')} <span>{siteGetStr(b, 'owner', '')}</span>
      <br />
      <a href={siteGetStr(footer, 'impressumHref', '/impressum/')}>{siteGetStr(ui, 'footerImpressum', 'Impressum')}</a> ·{' '}
      <a href={siteGetStr(footer, 'datenschutzHref', '/datenschutz/')}>{siteGetStr(ui, 'footerDatenschutz', 'Datenschutz')}</a>
    </div>
  </div>
</footer>

<nav class="sticky-bar" data-sticky aria-label={siteGetStr(ui, 'stickyAria', 'Schnellzugriff')}>
  <a class="sticky-bar__item" href={siteGetStr(b, 'phoneHref', 'tel:')} aria-label={siteGetStr(ui, 'stickyCall', 'Anrufen')}>
    <svg class="sticky-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 12a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
    </svg>
    <span class="sticky-bar__label">{siteGetStr(ui, 'stickyCall', 'Anrufen')}</span>
  </a>
  <a class="sticky-bar__item" href={'mailto:' + siteGetStr(b, 'email', '')} data-sticky-mail aria-label={siteGetStr(ui, 'stickyMailAria', 'E-Mail schreiben')}>
    <svg class="sticky-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6h16v12H4zM4 7l8 6 8-6" />
    </svg>
    <span class="sticky-bar__label">{siteGetStr(ui, 'stickyMail', 'Mail')}</span>
  </a>
  <a class="sticky-bar__item" href="/#kontakt" aria-label={siteGetStr(ui, 'stickyContactAria', 'Anfrage / Kontaktformular')}>
    <svg class="sticky-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
      <path d="M7.5 9h9M7.5 12.5h6" />
    </svg>
    <span class="sticky-bar__label">{siteGetStr(ui, 'stickyContact', 'Anfrage')}</span>
  </a>
  <button class="sticky-bar__item sticky-bar__item--btn" type="button" data-to-top aria-label={siteGetStr(ui, 'stickyTopAria', 'Nach oben scrollen')}>
    <svg class="sticky-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="sticky-bar__label">{siteGetStr(ui, 'stickyTop', 'Nach oben')}</span>
  </button>
</nav>