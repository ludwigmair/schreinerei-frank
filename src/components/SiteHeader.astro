---
/**
 * Header-Partial (Port von php/header.php).
 * Erwartet: s (SiteData).
 */
import { type SiteData, siteGetStr, siteAsset } from '../lib/data.ts';

interface Props {
    s: SiteData;
}

const { s } = Astro.props;
const b = (s['business'] ?? {}) as Record<string, unknown>;
const nav = (s['nav'] ?? []) as { href?: string; label?: string }[];
const ui = (s['ui'] ?? {}) as Record<string, unknown>;
---

<a class="skip-link" href="#inhalt">{siteGetStr(ui, 'skipLink', 'Zum Inhalt springen')}</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={siteGetStr(ui, 'brandAria', 'Schreinerei Frank – Startseite')}>
      <img class="brand__logo" src={siteAsset(s, 'site/frank-logo-opt.png')} width="54" height="70" alt="" loading="eager" />
      <span class="brand__name">{siteGetStr(b, 'name', 'Schreinerei Frank')}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={siteGetStr(ui, 'navToggleAria', 'Menü öffnen')}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label={siteGetStr(ui, 'navAria', 'Hauptnavigation')}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={'/' + (item.href ?? '#').replace(/^\//, '')}>{item.label ?? ''}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="tel-btn" href={siteGetStr(b, 'phoneHref', 'tel:')} aria-label={siteGetStr(ui, 'telBtnAria', 'Anrufen')}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 12a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
      </svg>
      <span class="tel-btn__num">{siteGetStr(b, 'phone', '')}</span>
    </a>
  </div>
</header>