---
permalink: /datenschutz/index.html
eleventyComputed:
  title: "{{ site.legal.datenschutz.title }}"
  description: "{{ site.legal.datenschutz.metaDescription }}"
  canonical: "{{ site.meta.siteUrl }}/datenschutz/"
---
{% include "head.njk" %}

<div class="legal wrap">
  <header class="legal__head">
    <p class="kicker"><a href="/">← Zurück</a></p>
    <h1>{{ site.legal.datenschutz.heading }}</h1>
    <p class="legal__intro">{{ site.legal.datenschutz.intro }}</p>
  </header>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.controller.kicker }}</h2>
    <p class="legal__pre">{{ site.legal.datenschutz.controller.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.processing.kicker }}</h2>
    <p>{{ site.legal.datenschutz.processing.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.serverLogs.kicker }}</h2>
    <p>{{ site.legal.datenschutz.serverLogs.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.cookies.kicker }}</h2>
    <p>{{ site.legal.datenschutz.cookies.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.contactForm.kicker }}</h2>
    <p>{{ site.legal.datenschutz.contactForm.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.googleMaps.kicker }}</h2>
    <p>{{ site.legal.datenschutz.googleMaps.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.hosting.kicker }}</h2>
    <p>{{ site.legal.datenschutz.hosting.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.rights.kicker }}</h2>
    <p>{{ site.legal.datenschutz.rights.text }}</p>
  </section>

  <section class="legal__block">
    <h2>{{ site.legal.datenschutz.supervisoryAuthority.kicker }}</h2>
    <p>{{ site.legal.datenschutz.supervisoryAuthority.text }}</p>
  </section>
</div>

{% include "foot.njk" %}
