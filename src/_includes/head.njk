<!doctype html>
<html lang="de" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>

<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
<meta name="theme-color" content="#2C5138">
<meta name="author" content="{{ site.business.name }}, Inhaber {{ site.business.owner }}">

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website">
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="{{ site.business.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.meta.siteUrl }}{{ site.meta.ogImage }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Fonts (für Produktion self-hosten – siehe README) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Spectral:ital,wght@1,400&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>

<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

<div class="cookie-banner" data-cookie-banner role="dialog" aria-modal="false" aria-label="Cookie-Hinweis" hidden>
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text">Wir verwenden Cookies, um unsere Website nutzerfreundlicher zu gestalten – z.&nbsp;B. um Ihre Einstellungen zu speichern. Technisch notwendige Cookies bleiben aktiv; alle weiteren setzen wir nur mit Ihrer Zustimmung.</p>
    <div class="cookie-banner__actions">
      <button class="btn btn--block" type="button" data-cookie-accept>Alle akzeptieren</button>
      <button class="btn btn--ghost btn--block" type="button" data-cookie-decline>Nur notwendige</button>
    </div>
    <a class="cookie-banner__link" href="{{ site.footer.datenschutzHref }}">Datenschutzerklärung</a>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="Schreinerei Frank – Startseite">
      <img class="brand__logo" src="/assets/img/logo-schreinerei-frank.svg" width="40" height="40" alt="" loading="eager">
      <span>{{ site.business.name }}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Menü öffnen">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Hauptnavigation">
      <ul>
        <li><a href="/#leistungen">Leistungen</a></li>
        <li><a href="/#galerie">Arbeiten</a></li>
        <li><a href="/#ueber-uns">Über uns</a></li>
        <li><a href="/#rezensionen">Rezensionen</a></li>
        <li><a href="/#faq">Fragen</a></li>
        <li><a href="/#kontakt">Kontakt</a></li>
      </ul>
    </nav>

    <a class="tel-btn" href="{{ site.business.phoneHref }}" aria-label="Anrufen: {{ site.business.phone }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 12a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
      {{ site.business.phone | replace("+49 ", "0") }}
    </a>
  </div>
</header>

<main id="inhalt">
