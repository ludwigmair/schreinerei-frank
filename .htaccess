# Schreinerei Frank – Apache-Konfiguration (Astro-Template)
# Statische Site aus dist/; verbleibende PHP-Endpunkte: Admin + Kontakt + Backup.

RewriteEngine On

# >>> PROJECT ADMIN (generiert aus php/config.php) >>>
SetEnvIf Request_URI ".*" ADMIN_PATH=/frank-adm

# Alte Admin-URL (/admin/) auf das neue Admin weiterleiten
RewriteCond %{ENV:ADMIN_PATH} ^(/[^/]+)$
RewriteRule ^admin(/.*)?$ %1/ [R=301,L]

# Admin-includes nie direkt aufrufen
<IfModule mod_rewrite.c>
  RewriteCond %{ENV:ADMIN_PATH} ^(/[^/]+)$
  RewriteRule ^%1/includes/.*\.php$ - [F]
</IfModule>
# <<< PROJECT ADMIN (generiert aus php/config.php) <<<

# Verbleibende dynamische PHP-Endpunkte
RewriteRule ^api/kontakt$      api/kontakt.php  [L]

# Statische SEO-/KI-Dateien liegen als Build-Output im Web-Root.

# Verzeichnisse ohne Datei -> index.html (Astro: /impressum/ => impressum/index.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+?)/?$ $1/index.html [L]

# Caching für Assets (Bilder, CSS, JS) – 1 Jahr immutable
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# Sicherheit: Admin-Ordner vor Zugriff schützen (PHP-Handling kommt aus frank-adm/)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Sensible Daten-Dateien nicht direkt ausliefern
<FilesMatch "^(admin\.json|admin\.local\.json|site\.json|\.env)$">
  Require all denied
</FilesMatch>